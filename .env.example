# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Places API
VITE_GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Test Account (for browser automation testing)
# Create a test user in Supabase Dashboard > Authentication > Users
# Enable "Email Provider" in Authentication > Providers
DISHRANK_TEST_EMAIL=test@example.com
DISHRANK_TEST_PASSWORD=your-test-password
